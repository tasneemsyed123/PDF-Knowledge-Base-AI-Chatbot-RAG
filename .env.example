# =============================================================================
# PDF Knowledge Base AI Chatbot - environment variables for all 3 services
# =============================================================================
# This is a REFERENCE file. Each service reads its OWN .env at runtime (Node's
# dotenv, Next.js, and Python's pydantic-settings all only look inside their
# own directory) - copy the relevant section below into:
#   backend/.env
#   frontend/.env.local
#   python-ai/.env
# See README.md's Setup section for the full step-by-step.

# =============================================================================
# ## backend/.env
# =============================================================================

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Infra (matches the root docker-compose.yml host ports)
MONGO_URI=mongodb://localhost:27018/pdf_rag_chatbot
REDIS_URL=redis://localhost:6380

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Seeded admin account (run `npm run seed-admin` after setting these)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
ADMIN_NAME=Admin

# Shared with python-ai - both services must point at the SAME absolute path
UPLOAD_DIR=

# Resilience
STALE_DOCUMENT_TIMEOUT_MINUTES=10
CHAT_REQUEST_TIMEOUT_MS=60000

# Set to true ONLY if this runs behind a real reverse proxy/load balancer
# (nginx, ALB, etc) that sets X-Forwarded-For - otherwise leave false, since
# trusting it blindly lets clients spoof their IP and bypass rate limiting.
TRUST_PROXY=false

# =============================================================================
# ## frontend/.env.local
# =============================================================================

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api

# =============================================================================
# ## python-ai/.env
# =============================================================================

# Infra (matches the root docker-compose.yml host port)
REDIS_URL=redis://localhost:6380

# The backend sends the absolute file path directly in each
# document:process:request message - this is NOT used to build that path,
# it's used to CONTAIN it: every incoming path must resolve inside this
# directory or it's rejected (defense in depth if Redis is ever reachable
# by something other than the backend). Must match the backend's UPLOAD_DIR.
# Default below is correct as long as uvicorn is started from python-ai/.
UPLOAD_DIR=../storage/uploads

FAISS_PERSIST_DIR=./faiss_index

# Free local embedding model - no API key needed, downloads once on first run
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4

# groq | gemini | openrouter - only the selected provider's key is required
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
