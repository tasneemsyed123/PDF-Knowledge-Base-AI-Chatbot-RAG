# Infra (matches the root docker-compose.yml host port)
REDIS_URL=redis://localhost:6380

# The backend sends the absolute file path directly in each
# document:process:request message - this is NOT used to build that path,
# it's used to CONTAIN it: every incoming path must resolve inside this
# directory or it's rejected (defense in depth if Redis is ever reachable
# by something other than the backend). Must match the backend's UPLOAD_DIR.
# Default below is correct as long as uvicorn is started from python-ai/.
UPLOAD_DIR=../storage/uploads

FAISS_PERSIST_DIR=./faiss_index

# Free local embedding model - no API key needed, downloads once on first run
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4

# groq | gemini | openrouter - only the selected provider's key is required
LLM_PROVIDER=groq

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
